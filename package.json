{
  "private": true,
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "setup": "npm --prefix client ci && npm --prefix tools ci",
    "start": "node scripts/local-mesh.mjs start",
    "stop": "node scripts/local-mesh.mjs stop",
    "smoke": "node scripts/local-mesh.mjs smoke",
    "bench": "node scripts/local-mesh.mjs bench",
    "bench:quick": "node scripts/bench-quick.mjs",
    "bench:compare": "node scripts/compare-mesh.mjs",
    "bench:clusters": "cargo run --locked --release -p infinite-stars --bin cluster-bench -- target/cluster-players.json",
    "bench:cluster-wire": "cargo run --locked --release -p infinite-stars --bin cluster-wire -- target/cluster-wire.json",
    "test:game": "node scripts/test-game-integration.mjs",
    "sdk:ingest": "node scripts/sdk-rag.mjs ingest sdkcache/",
    "test": "cargo test --workspace --locked && npm --prefix tools test && npm --prefix client run build"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  }
}
