# Multi-stage build for coordinator and sim-server
FROM rust:1.86-bookworm AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates/ crates/

RUN cargo build --release -p coordinator -p sim-server -p gateway

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/coordinator /usr/local/bin/coordinator
COPY --from=builder /app/target/release/sim-server /usr/local/bin/sim-server
COPY --from=builder /app/target/release/gateway /usr/local/bin/gateway

# Default entrypoint — override in docker-compose
ENTRYPOINT ["sim-server"]
