# UNO Q board network configuration.
# Source this from UNO Q scripts: source "$(dirname "$0")/boards.env"
#
# If a board gets a new DHCP lease, update the IP here — one file, all scripts.
# After changing an IP, regenerate the TLS cert: rm certs/mesh-coordinator.* && ./start-unoq.sh

UNOQ=unoq
UNOQ2=unoq2
UNOQ3=unoq3
ZZTTPI=zzttpi

UNOQ_IP=192.168.0.15
UNOQ2_IP=192.168.0.173
UNOQ3_IP=192.168.0.86
ZZTTPI_IP=192.168.0.208
